# ============================================================================
# ITER TIC - Variáveis de Ambiente
# ============================================================================
# Copie este arquivo para .env e preencha os valores conforme seu ambiente.
#   cp .env.example .env
# ============================================================================

# ── Segurança (JWT) ─────────────────────────────────────────────────────────
# Gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=minha_chave_super_secreta_de_desenvolvimento

# ── Banco de Dados ──────────────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/itertic

# ── SMTP (E-mail) ──────────────────────────────────────────────────────────
# Deixe SMTP_HOST vazio para modo DEV (links aparecem no console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@itertic.pcdf.df.gov.br
SMTP_USE_TLS=true

# ── Frontend ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
